# ── Local dev ─────────────────────────────────────────────────────────────────
# Copy to .env.local. Everything below is OPTIONAL in development: with no keys the
# stack runs mocks-first (hosted Paystack test checkout, mock NIMC, logged SMS/email).
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# ── Database ──────────────────────────────────────────────────────────────────
# Unset → embedded PGlite at <repo>/.cache/pglite (dev). Set → real PostgreSQL.
# DATABASE_URL=postgres://kith:kith@localhost:5432/kith
# PGLITE_DIR=/absolute/path/to/pglite   # optional override

# ── Paystack ──────────────────────────────────────────────────────────────────
# Leave ALL THREE empty to run the golden flow against the built-in mock driver
# (hosted test checkout at /checkout/mock, still signed + signature-verified).
# Set a real test key to switch to api.paystack.co with zero code changes:
#   webhook URL: https://<app>/api/webhooks/paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ── Identity (NIMC) ───────────────────────────────────────────────────────────
# Unset → MockNimc (11-digit NINs verify; 00000000000 is the "not found" demo case).
# Set both → LiveNimc POSTs {nin, firstName, lastName, dateOfBirth} to <base>/nin/verify.
NIN_PEPPER=dev-pepper-change-me
NIMC_API_KEY=
NIMC_BASE_URL=

# ── Messaging (Termii SMS · Resend email) ─────────────────────────────────────
# Unset → MockNotifier: sends are logged with a [MOUTHPIECE] prefix and still recorded
# in the notifications table, so the in-app feed is complete in demos.
TERMII_API_KEY=
TERMII_SENDER_ID=Kith
RESEND_API_KEY=
EMAIL_FROM="Kith <hello@kith.ng>"

# ── Workers / internal plumbing ───────────────────────────────────────────────
# Cron: POST /api/cron/settle every minute (auction settlement, escrow auto-release,
# payout push, notification outbox). vercel.json schedules it; set this in production.
CRON_SECRET=

# ── Analytics (optional) ──────────────────────────────────────────────────────
# Leave empty to ship no analytics script at all. Set to switch Plausible on.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ── Deployment notes ─────────────────────────────────────────────────────────
# Vercel: set DATABASE_URL to the Supabase POOLER string (port 6543, ?pgbouncer=true)
# for serverless, and run migrations from CI or locally against the direct string.
# See docs/DEPLOYMENT.md for the full matrix and the go-live checklist.
# Shared secret for web → realtime fan-out (POST /internal/publish).
INTERNAL_SECRET=kith-internal-dev
REALTIME_INTERNAL_URL=http://localhost:3001
